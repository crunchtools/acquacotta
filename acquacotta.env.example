# Flask session secret key (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=your-secret-key-here

# Google OAuth credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# MCP access token sealing key (Fernet key: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# If unset, it is derived from FLASK_SECRET_KEY (fine for dev). Set explicitly in
# production; rotating this key is the global panic-revoke for all MCP tokens.
MCP_TOKEN_SEAL_KEY=

# pCloud OAuth credentials (from https://docs.pcloud.com/my_apps/ — the redirect URI
# must be <OAUTH_REDIRECT_BASE>/auth/pcloud/callback). Optional: without these the
# "JSON on pCloud" storage plugin cannot be linked, but everything else works.
PCLOUD_CLIENT_ID=your-pcloud-client-id
PCLOUD_CLIENT_SECRET=your-pcloud-client-secret

# RT Tickets plugin — optional destination allowlist for the server-side RT proxy.
# Comma-separated hostnames; when set, a user's RT base_url host must be in the list
# and it may then be a private address (an RT reached directly behind an auth
# proxy). Unset = public addresses only. Example: rt-internal,rt.example.com
RT_ALLOWED_HOSTS=

# Social Share plugin: hosts the server may reach for Postiz even though they
# resolve to private addresses (a Postiz on the same host or LAN). Unset = Postiz
# must be on a public address. Shared pages are always public-only.
SOCIAL_ALLOWED_HOSTS=

# Public URL of this Acquacotta (e.g. https://acquacotta.example.com). MCP tools
# use it to give each todo, discussion, ticket and pomodoro a "link" that opens
# it in the web app. Unset = falls back to OAUTH_REDIRECT_BASE, else no links.
ACQUACOTTA_PUBLIC_URL=
