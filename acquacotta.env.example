# Flask session secret key (generate with: python3 -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=your-secret-key-here

# Google OAuth credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# MCP access token sealing key (Fernet key: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# If unset, it is derived from FLASK_SECRET_KEY (fine for dev). Set explicitly in
# production; rotating this key is the global panic-revoke for all MCP tokens.
MCP_TOKEN_SEAL_KEY=

# pCloud OAuth credentials (from https://docs.pcloud.com/my_apps/ — the redirect URI
# must be <OAUTH_REDIRECT_BASE>/auth/pcloud/callback). Optional: without these the
# "JSON on pCloud" storage plugin cannot be linked, but everything else works.
PCLOUD_CLIENT_ID=your-pcloud-client-id
PCLOUD_CLIENT_SECRET=your-pcloud-client-secret
